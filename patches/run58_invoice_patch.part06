      tx.update(customerRef, {'balance': finalBalance, 'updatedAt': FieldValue.serverTimestamp()});
      tx.set(db.collection('accountMovements').doc(), {
        'accountType': 'customers', 'accountId': customerId, 'accountName': customerName,
        'kind': 'sale', 'amount': total, 'paid': paid, 'balanceBefore': previous,
        'balanceAfter': finalBalance, 'referenceId': invoice.id,
        'createdAt': FieldValue.serverTimestamp(), 'actorId': actor,
      });
    }

    tx.set(invoice, {
      'invoiceNumber': invoiceNumber,
      'branchId': branchId,
      'employeeId': actor,
      'customerId': customerId ?? '',
      'customerName': customerName,
      'customerPhone': customerPhone,
      'items': items,
      'total': total,
      'paid': paid,
      'due': currentDue,
      'previousBalance': previous,
      'balanceAfter': finalBalance,
      'paymentStatus': currentDue <= 0 ? 'مدفوع' : paid <= 0 ? 'آجل' : 'جزئي',
      'status': 'completed',
      'grouped': true,
      'createdAt': FieldValue.serverTimestamp(),
    });
  });
  return invoice;
}'''
replace_between('Future<DocumentReference<Map<String, dynamic>>> saveManagerGroupedSale({',
                '// Employee grouped sales keep the existing line-per-sale structure', sale_save)

