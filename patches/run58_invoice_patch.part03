        final account = selectedAccount?.data() ?? <String, dynamic>{};
        if (widget.owner) {
          ref = await saveManagerGroupedSale(
            entries: entries,
            products: await db.collection('products').where('active', isEqualTo: true).get(),
            branchId: widget.branchId,
            invoiceNumber: invoiceNumber.text.trim(),
            customerId: selectedAccountId,
            customerName: '${account['name'] ?? ''}',
            customerPhone: '${account['phone'] ?? ''}',
            paid: paidNow,
          );
        } else {
          ref = await saveGroupedSale(
            entries: entries,
            products: await db.collection('products').where('active', isEqualTo: true).get(),
            branchId: widget.branchId,
            owner: false,
            customerId: null,
            customerName: '',
            customerPhone: '',
            paid: invoiceTotal,
          );
        }
      } else {
        final entries = lines.map((e) => (id: e.productId, qty: e.quantity, cost: e.price)).toList();
        ref = await saveManagerGroupedPurchase(
          entries: entries,
          supplierId: selectedAccountId!,
          suppliers: await db.collection('suppliers').get(),
          products: await db.collection('products').where('active', isEqualTo: true).get(),
          invoiceNumber: invoiceNumber.text.trim(),
          paid: paidNow,
          markupPercent: null,
          source: 'manual',
        );
      }
      final snap = await ref.get();
      if (!mounted) return;
      setState(() { savedRef = ref; savedData = snap.data() ?? _draftData(); saving = false; });
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('تم حفظ الفاتورة كاملة وتحديث المخزون والحساب')));
    } catch (e) {
      if (!mounted) return;
      setState(() => saving = false);
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('تعذر حفظ الفاتورة: $e')));
    }
  }

  Widget _money(double value, {Color? color, double size = 16}) => Text(
    '${value.toStringAsFixed(2)} ج.م',
    style: TextStyle(fontSize: size, fontWeight: FontWeight.bold, color: color));

  Widget _topCard() {
    final account = selectedAccount?.data();
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(border: Border.all(color: gold.withValues(alpha: .65)),
        borderRadius: BorderRadius.circular(18)),
      child: Column(children: [
        Wrap(spacing: 14, runSpacing: 10, crossAxisAlignment: WrapCrossAlignment.center, children: [
          FilledButton.icon(onPressed: widget.isSale && !widget.owner ? null : _chooseAccount,
            icon: const Icon(Icons.person), label: Text(widget.isSale ? 'اختيار عميل' : 'اختيار مورد')),
          SizedBox(width: 300, child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Text('${account?['name'] ?? (widget.isSale ? 'لم يتم اختيار العميل' : 'لم يتم اختيار المورد')}',
              style: const TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),
            if (account != null && '${account['phone'] ?? ''}'.isNotEmpty) Text('هاتف: ${account['phone']}'),
          ])),
          SizedBox(width: 160, child: TextField(controller: invoiceNumber, enabled: savedRef == null,
            textAlign: TextAlign.center, decoration: const InputDecoration(labelText: 'رقم الفاتورة'))),
          Text('التاريخ\n${DateFormat('dd/MM/yyyy').format(DateTime.now())}', textAlign: TextAlign.center),
        ]),
        const Divider(),
        Row(children: [
          Text(widget.isSale ? 'الرصيد السابق على العميل:' : 'الرصيد السابق على المورد:'),
          const SizedBox(width: 8), _money(previousBalance, color: gold, size: 19),
        ]),
      ]),
    );
  }

  Widget _productToolbar() => LayoutBuilder(builder: (context, constraints) {
    final compact = constraints.maxWidth < 430;
    return Row(children: [
      SizedBox(
        width: compact ? 72 : 88,
        height: 50,
        child: FilledButton(
          style: FilledButton.styleFrom(
            padding: const EdgeInsets.symmetric(horizontal: 6),
            minimumSize: Size.zero,
          ),
          onPressed: savedRef == null ? () => _chooseProduct(scannerMode: true) : null,
          child: FittedBox(
            fit: BoxFit.scaleDown,
            child: Row(mainAxisSize: MainAxisSize.min, children: [
              const Icon(Icons.qr_code_scanner, size: 18),
              if (!compact) ...[
                const SizedBox(width: 4),
                const Text('ماسح', style: TextStyle(fontSize: 13, fontWeight: FontWeight.w600)),
              ],
            ]),
          ),
        ),
      ),
      const SizedBox(width: 7),
      Expanded(
        flex: 5,
        child: SizedBox(
          height: 50,
          child: TextField(
            controller: productSearch,
            enabled: savedRef == null,
            textAlignVertical: TextAlignVertical.center,
            onTap: savedRef == null ? () => _chooseProduct() : null,
            onSubmitted: (_) => _addFromSearch(),
            decoration: InputDecoration(
              prefixIcon: const Icon(Icons.search, size: 21),
              hintText: 'بحث عن منتج بالاسم أو الكود',
              contentPadding: const EdgeInsets.symmetric(horizontal: 10, vertical: 10),
              border: OutlineInputBorder(borderRadius: BorderRadius.circular(14)),
            ),
          ),
        ),
      ),
      const SizedBox(width: 7),
      SizedBox(
        width: compact ? 76 : 105,
        height: 50,
        child: FilledButton(
          style: FilledButton.styleFrom(
            padding: const EdgeInsets.symmetric(horizontal: 6),
            minimumSize: Size.zero,
          ),
          onPressed: savedRef == null ? () => _chooseProduct() : null,
          child: FittedBox(
            fit: BoxFit.scaleDown,
            child: Row(mainAxisSize: MainAxisSize.min, children: [
              const Icon(Icons.add, size: 19),
              if (!compact) ...[
                const SizedBox(width: 4),
                const Text('إضافة منتج', style: TextStyle(fontSize: 13, fontWeight: FontWeight.w600)),
              ],
            ]),
          ),
        ),
      ),
    ]);
  });

  Widget _itemsTable() => Directionality(
    textDirection: TextDirection.rtl,
    child: Container(
      width: double.infinity,
      decoration: BoxDecoration(
        border: Border.all(color: gold.withValues(alpha: .55)),
        borderRadius: BorderRadius.circular(16),
      ),
      child: Column(children: [
        Container(
          padding: const EdgeInsets.symmetric(vertical: 10, horizontal: 5),
          decoration: const BoxDecoration(
            color: gold,
            borderRadius: BorderRadius.vertical(top: Radius.circular(15)),
          ),
          child: const Row(children: [
            SizedBox(
              width: 30,
              child: Text('م', textAlign: TextAlign.center,
                style: TextStyle(color: Colors.black, fontSize: 12, fontWeight: FontWeight.bold)),
            ),
            Expanded(
              flex: 5,
              child: Text('المنتج', textAlign: TextAlign.center,
                style: TextStyle(color: Colors.black, fontSize: 12, fontWeight: FontWeight.bold)),
            ),
            Expanded(
              flex: 2,
              child: Text('السعر', textAlign: TextAlign.center,
                style: TextStyle(color: Colors.black, fontSize: 12, fontWeight: FontWeight.bold)),
            ),
            SizedBox(
              width: 52,
              child: Text('العدد', textAlign: TextAlign.center,
                style: TextStyle(color: Colors.black, fontSize: 12, fontWeight: FontWeight.bold)),
            ),
            Expanded(
              flex: 2,
              child: Text('الإجمالي', textAlign: TextAlign.center,
                style: TextStyle(color: Colors.black, fontSize: 12, fontWeight: FontWeight.bold)),
            ),
            SizedBox(
              width: 38,
              child: Text('حذف', textAlign: TextAlign.center,
                style: TextStyle(color: Colors.black, fontSize: 11, fontWeight: FontWeight.bold)),
            ),
          ]),
        ),
        if (lines.isEmpty)
          const Padding(
            padding: EdgeInsets.all(26),
            child: Center(child: Text('أضف الأصناف إلى الفاتورة')),
          ),
        for (var i = 0; i < lines.length; i++)
          InkWell(
            onTap: () => _editLine(lines[i]),
            child: Container(
              padding: const EdgeInsets.symmetric(vertical: 9, horizontal: 5),
              decoration: BoxDecoration(
                border: Border(top: BorderSide(color: Colors.white.withValues(alpha: .10))),
              ),
              child: Row(children: [
                SizedBox(
                  width: 30,
                  child: Text('${i + 1}', textAlign: TextAlign.center,
                    style: const TextStyle(fontSize: 13, fontWeight: FontWeight.bold)),
                ),
                Expanded(
                  flex: 5,
                  child: Text(
                    lines[i].name,
                    textAlign: TextAlign.center,
                    maxLines: 2,
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(fontSize: 13),
                  ),
                ),
                Expanded(
                  flex: 2,
                  child: Text(
                    lines[i].price.toStringAsFixed(2),
                    textAlign: TextAlign.center,
                    style: const TextStyle(fontSize: 12),
                  ),
                ),
                SizedBox(
                  width: 52,
                  child: Text(
                    '${lines[i].quantity}',
                    textAlign: TextAlign.center,
                    style: const TextStyle(color: gold, fontSize: 15, fontWeight: FontWeight.bold),
                  ),
                ),
                Expanded(
                  flex: 2,
                  child: Text(
                    lines[i].total.toStringAsFixed(2),
                    textAlign: TextAlign.center,
                    style: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold),
                  ),
                ),
                SizedBox(
                  width: 38,
                  child: IconButton(
                    padding: EdgeInsets.zero,
                    constraints: const BoxConstraints(minWidth: 34, minHeight: 34),
                    visualDensity: VisualDensity.compact,
                    icon: const Icon(Icons.delete, color: Colors.redAccent, size: 20),
                    onPressed: savedRef == null ? () => setState(() => lines.removeAt(i)) : null,
                  ),
                ),
              ]),
            ),
          ),
      ]),
    ),
  );

