          SizedBox(width: 42, child: Text('م', textAlign: TextAlign.center, style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold))),
          SizedBox(width: 275, child: Text('المنتج', textAlign: TextAlign.center, style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold))),
          SizedBox(width: 120, child: Text('السعر', textAlign: TextAlign.center, style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold))),
          SizedBox(width: 100, child: Text('العدد', textAlign: TextAlign.center, style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold))),
          SizedBox(width: 130, child: Text('الإجمالي', textAlign: TextAlign.center, style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold))),
          SizedBox(width: 70, child: Text('حذف', textAlign: TextAlign.center, style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold))),
        ])),
      if (lines.isEmpty) const SizedBox(width: 760, child: Padding(padding: EdgeInsets.all(30),
        child: Center(child: Text('أضف الأصناف إلى الفاتورة')))),
      for (var i = 0; i < lines.length; i++)
        InkWell(onTap: () => _editLine(lines[i]), child: Container(
          decoration: BoxDecoration(border: Border(top: BorderSide(color: Colors.white.withValues(alpha: .10)))),
          padding: const EdgeInsets.symmetric(vertical: 9, horizontal: 8),
          child: Row(children: [
            SizedBox(width: 42, child: Text('${i + 1}', textAlign: TextAlign.center)),
            SizedBox(width: 275, child: Text(lines[i].name, textAlign: TextAlign.center, overflow: TextOverflow.ellipsis)),
            SizedBox(width: 120, child: Text(lines[i].price.toStringAsFixed(2), textAlign: TextAlign.center)),
            SizedBox(width: 100, child: Text('${lines[i].quantity}', textAlign: TextAlign.center)),
            SizedBox(width: 130, child: Text(lines[i].total.toStringAsFixed(2), textAlign: TextAlign.center,
              style: const TextStyle(fontWeight: FontWeight.bold))),
            SizedBox(width: 70, child: IconButton(icon: const Icon(Icons.delete, color: Colors.redAccent),
              onPressed: savedRef == null ? () => setState(() => lines.removeAt(i)) : null)),
          ]),
        )),
    ])),
  ));

  Widget _paymentCard() => Container(
    width: double.infinity, padding: const EdgeInsets.all(16),
    decoration: BoxDecoration(border: Border.all(color: gold.withValues(alpha: .55)),
      borderRadius: BorderRadius.circular(18)),
    child: Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
      const Text('تفاصيل السداد والرصيد', style: TextStyle(color: gold, fontSize: 19, fontWeight: FontWeight.bold)),
      const Divider(),
      ListTile(title: Text(widget.isSale ? 'الرصيد السابق على العميل' : 'الرصيد السابق على المورد'),
        trailing: _money(previousBalance)),
      ListTile(title: const Text('إجمالي المستحق (السابق + الحالي)'), trailing: _money(totalDueBeforePayment)),
      Row(children: [
        const Expanded(child: Text('المدفوع نقدًا الآن', style: TextStyle(fontSize: 16))),
        SizedBox(width: 190, child: TextField(controller: paid, enabled: savedRef == null,
          keyboardType: const TextInputType.numberWithOptions(decimal: true), onChanged: (_) => setState(() {}),
          textAlign: TextAlign.center, decoration: const InputDecoration(suffixText: 'ج.م'))),
      ]),
      ListTile(title: const Text('باقي هذه الفاتورة'),
        trailing: _money(currentInvoiceDue, color: currentInvoiceDue == 0 ? Colors.greenAccent : gold)),
      ListTile(title: Text(widget.isSale ? 'المتبقي إجمالي على العميل' : 'المتبقي إجمالي على المورد'),
        trailing: _money(balanceAfter, color: gold, size: 19)),
      const SizedBox(height: 8),
      Container(padding: const EdgeInsets.all(14),
        decoration: BoxDecoration(color: paymentStatus == 'مدفوعة بالكامل'
          ? Colors.green.withValues(alpha: .18) : gold.withValues(alpha: .10), borderRadius: BorderRadius.circular(14)),
        child: Text('حالة الفاتورة الحالية: $paymentStatus', textAlign: TextAlign.center,
          style: TextStyle(color: paymentStatus == 'مدفوعة بالكامل' ? Colors.greenAccent : gold,
            fontWeight: FontWeight.bold, fontSize: 17))),
    ]));

  @override Widget build(BuildContext context) {
    if (loading) return const Scaffold(body: Center(child: CircularProgressIndicator(color: gold)));
    return Scaffold(
      appBar: AppBar(
        title: Text(widget.isSale ? 'فاتورة مبيعات' : 'فاتورة مشتريات',
          style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
        centerTitle: true,
        leading: IconButton(icon: const Icon(Icons.arrow_back, color: gold), onPressed: () => Navigator.pop(context)),
        actions: [Padding(padding: const EdgeInsetsDirectional.only(end: 8), child: FilledButton.icon(
          onPressed: _printDraft, icon: const Icon(Icons.print), label: const Text('طباعة')))],
      ),
      body: SingleChildScrollView(padding: const EdgeInsets.all(14), child: Column(children: [
        _topCard(), const SizedBox(height: 14),
        _productToolbar(), const SizedBox(height: 12),
        _itemsTable(), const SizedBox(height: 14),
