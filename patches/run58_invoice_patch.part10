# Diagnostic only: print the exact Repairs screen source so the next patch can target the visible screen.
for needle in ['الضبط والإصلاحات', 'فواتير المبيعات والمرتجعات', 'المصروفات وحركة الصندوق', 'البصمة']:
    pos = text.find(needle)
    if pos >= 0:
        print('VIB_REPAIRS_SCREEN_SNIPPET_START', needle)
        print(text[max(0, pos-5000):min(len(text), pos+9000)])
        print('VIB_REPAIRS_SCREEN_SNIPPET_END')
        break
\n# reset permission fix build\n