        unitCost: (d['purchasePrice'] as num?)?.toDouble(),
      ));
    }
    if (refresh && mounted) setState(() {});
  }

  List<QueryDocumentSnapshot<Map<String, dynamic>>> _matchingProducts(String query) {
    final q = query.trim().toLowerCase();
    return products.where((p) {
      final d = p.data();
      final hay = [d['name'], d['category'], d['code'], d['barcode']]
        .map((v) => '${v ?? ''}'.toLowerCase()).join(' ');
      return q.isEmpty || hay.contains(q);
    }).toList();
  }

  Future<void> _askQuantityAndAdd(QueryDocumentSnapshot<Map<String, dynamic>> p) async {
    if (savedRef != null) return;
    final available = widget.isSale ? _availableFor(p.id) : null;
    final qty = TextEditingController(text: '1');
    final result = await showDialog<int>(
      context: context,
      builder: (dialog) => AlertDialog(
        title: Text('${p.data()['name'] ?? ''}'),
        content: Column(mainAxisSize: MainAxisSize.min, children: [
          if (widget.isSale)
            Align(
              alignment: AlignmentDirectional.centerStart,
              child: Text(
                'المتوفر الآن: ${available ?? 0} قطعة',
                style: const TextStyle(color: gold, fontSize: 16, fontWeight: FontWeight.bold),
              ),
            ),
          const SizedBox(height: 10),
          TextField(
            controller: qty,
            autofocus: true,
            keyboardType: TextInputType.number,
            textAlign: TextAlign.center,
            decoration: const InputDecoration(
              labelText: 'الكمية',
              hintText: 'مثال: 10',
            ),
            onSubmitted: (_) {
              final q = int.tryParse(_ocrNumber(qty.text.trim()));
              if (q != null && q > 0 && (!widget.isSale || q <= (available ?? 0))) {
                Navigator.pop(dialog, q);
              }
            },
          ),
        ]),
        actions: [
          TextButton(onPressed: () => Navigator.pop(dialog), child: const Text('إلغاء')),
          FilledButton(
            onPressed: () {
              final q = int.tryParse(_ocrNumber(qty.text.trim()));
              if (q == null || q <= 0) {
                ScaffoldMessenger.of(dialog).showSnackBar(
                  const SnackBar(content: Text('اكتب كمية صحيحة')));
                return;
              }
              if (widget.isSale && q > (available ?? 0)) {
                ScaffoldMessenger.of(dialog).showSnackBar(SnackBar(
                  content: Text('العدد المطلوب $q أكبر من الموجود. المتوفر ${available ?? 0} فقط')));
                return;
              }
              Navigator.pop(dialog, q);
            },
            child: const Text('إضافة'),
          ),
        ],
      ),
    );
    qty.dispose();
    if (result != null && mounted) {
      _addProduct(p, quantity: result);
    }
  }

  Future<void> _chooseProduct({bool scannerMode = false}) async {
    if (savedRef != null) return;
    String query = scannerMode ? productSearch.text.trim() : '';
    final result = await showModalBottomSheet<String>(
      context: context,
      isScrollControlled: true,
      backgroundColor: const Color(0xFF17130D),
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (sheet) => StatefulBuilder(builder: (sheet, update) {
        final filtered = _matchingProducts(query);
        return SafeArea(child: FractionallySizedBox(
          heightFactor: .90,
          child: Column(children: [
            Container(
              width: 54,
              height: 5,
              margin: const EdgeInsets.only(top: 10, bottom: 8),
              decoration: BoxDecoration(
                color: Colors.white24,
                borderRadius: BorderRadius.circular(10),
              ),
            ),
            Padding(
              padding: const EdgeInsets.fromLTRB(16, 4, 16, 10),
              child: Row(children: [
                Expanded(child: Text(
                  scannerMode ? 'ماسح / بحث عن منتج' : 'اختيار منتج',
                  style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold),
                )),
                IconButton(
                  tooltip: 'إغلاق',
                  onPressed: () => Navigator.pop(sheet),
                  icon: const Icon(Icons.close),
                ),
              ]),
            ),
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 14),
              child: TextField(
                autofocus: true,
                decoration: InputDecoration(
                  prefixIcon: Icon(scannerMode ? Icons.qr_code_scanner : Icons.search, color: gold),
                  hintText: 'بحث بالاسم أو الكود أو الباركود',
                  filled: true,
                  fillColor: const Color(0xFF0F0F0F),
                  border: OutlineInputBorder(borderRadius: BorderRadius.circular(14)),
                ),
                onChanged: (v) => update(() => query = v.trim()),
                onSubmitted: (_) {
                  if (filtered.length == 1) Navigator.pop(sheet, filtered.first.id);
                },
              ),
            ),
            const SizedBox(height: 8),
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 16),
              child: Row(children: [
                Text('النتائج: ${filtered.length}', style: const TextStyle(color: gold)),
                const Spacer(),
                const Text('العدد المتوفر يظهر لكل صنف', style: TextStyle(fontSize: 12, color: Colors.white70)),
              ]),
            ),
            const SizedBox(height: 6),
            Expanded(
              child: filtered.isEmpty
                ? const Center(child: Text('لا توجد نتائج'))
                : ListView.separated(
                    padding: const EdgeInsets.fromLTRB(10, 2, 10, 18),
                    itemCount: filtered.length,
                    separatorBuilder: (_, __) => const SizedBox(height: 6),
                    itemBuilder: (_, index) {
                      final p = filtered[index];
                      final d = p.data();
                      final available = _availableFor(p.id);
                      final salePrice = ((d['price'] as num?)?.toDouble() ?? 0);
                      final purchasePrice = ((d['purchasePrice'] as num?)?.toDouble() ?? 0);
                      final belowCost = widget.isSale && purchasePrice > 0 && salePrice < purchasePrice;
                      return Card(
                        margin: EdgeInsets.zero,
                        clipBehavior: Clip.antiAlias,
                        child: InkWell(
                          onTap: available <= 0 && widget.isSale
                            ? () => ScaffoldMessenger.of(context).showSnackBar(
                                SnackBar(content: Text('الصنف ${d['name'] ?? ''} غير متوفر في المخزون')))
                            : () => Navigator.pop(sheet, p.id),
                          child: Padding(
                            padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
                            child: Row(children: [
                              Container(
                                width: 42,
                                height: 42,
                                decoration: BoxDecoration(
                                  color: gold.withValues(alpha: .12),
                                  borderRadius: BorderRadius.circular(11),
                                ),
                                child: const Icon(Icons.inventory_2_outlined, color: gold, size: 22),
                              ),
                              const SizedBox(width: 12),
                              Expanded(child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  Text(
                                    '${d['name'] ?? ''}',
                                    style: const TextStyle(fontSize: 17, fontWeight: FontWeight.bold),
                                  ),
                                  const SizedBox(height: 5),
                                  Text(
                                    widget.isSale
                                      ? 'سعر البيع: ${salePrice.toStringAsFixed(2)} ج.م'
                                      : 'سعر الشراء: ${purchasePrice.toStringAsFixed(2)} ج.م',
                                    style: const TextStyle(fontSize: 14),
                                  ),
                                  const SizedBox(height: 3),
                                  Text(
                                    widget.isSale
                                      ? 'المتوفر الآن: $available قطعة'
                                      : 'المخزون الحالي: $available قطعة',
                                    style: TextStyle(
                                      color: available > 0 ? gold : Colors.redAccent,
                                      fontSize: 14,
                                      fontWeight: FontWeight.bold,
                                    ),
                                  ),
                                  if (belowCost) ...[
                                    const SizedBox(height: 3),
                                    const Text(
                                      'تنبيه: سعر البيع أقل من سعر الشراء',
                                      style: TextStyle(color: Colors.redAccent, fontSize: 13, fontWeight: FontWeight.bold),
                                    ),
                                  ],
                                ],
                              )),
                              const SizedBox(width: 10),
                              Icon(
                                available > 0 || !widget.isSale ? Icons.add_circle : Icons.block,
                                color: available > 0 || !widget.isSale ? gold : Colors.redAccent,
                                size: 30,
                              ),
                            ]),
                          ),
                        ),
                      );
                    },
                  ),
            ),
          ]),
        ));
      }),
    );
    if (result == null || !mounted) return;
    final p = products.firstWhere((e) => e.id == result);
    await _askQuantityAndAdd(p);
    productSearch.clear();
  }

  Future<void> _addFromSearch() async {
    final q = productSearch.text.trim();
    if (q.isEmpty) return _chooseProduct();
    final matches = _matchingProducts(q);
    if (matches.length == 1) {
      await _askQuantityAndAdd(matches.first);
      productSearch.clear();
    } else {
      await _chooseProduct(scannerMode: true);
    }
  }

  Future<void> _chooseAccount() async {
    if (savedRef != null) return;
    if (accounts.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text(widget.isSale ? 'لا يوجد عملاء مسجلون' : 'لا يوجد موردون مسجلون')));
      return;
    }
    String query = '';
    final result = await showModalBottomSheet<String>(context: context, isScrollControlled: true,
      builder: (sheet) => StatefulBuilder(builder: (sheet, update) {
        final filtered = accounts.where((a) {
          final d = a.data();
          final hay = '${d['name'] ?? ''} ${d['phone'] ?? ''}'.toLowerCase();
          return hay.contains(query.toLowerCase());
        }).toList();
        return SafeArea(child: SizedBox(height: MediaQuery.sizeOf(sheet).height * .72,
          child: Column(children: [
            Padding(padding: const EdgeInsets.all(12), child: TextField(
              autofocus: true,
              decoration: InputDecoration(prefixIcon: const Icon(Icons.search),
                labelText: widget.isSale ? 'بحث عن عميل' : 'بحث عن مورد'),
              onChanged: (v) => update(() => query = v.trim()),
            )),
            Expanded(child: ListView(children: filtered.map((a) {
              final d = a.data();
              return ListTile(
                leading: const Icon(Icons.person, color: gold),
                title: Text('${d['name'] ?? ''}'),
                subtitle: Text('هاتف: ${d['phone'] ?? ''} • الرصيد: ${((d['balance'] as num?)?.toDouble() ?? 0).toStringAsFixed(2)} ج.م'),
                onTap: () => Navigator.pop(sheet, a.id),
              );
            }).toList())),
          ])));
      }));
    if (result != null && mounted) setState(() => selectedAccountId = result);
  }

  Future<void> _editLine(InvoiceLineDraft line) async {
    if (savedRef != null) return;
    final qty = TextEditingController(text: line.quantity.toString());
    final price = TextEditingController(text: line.price.toStringAsFixed(2));
    await showDialog<void>(context: context, builder: (dialog) => AlertDialog(
      title: Text(line.name),
      content: Column(mainAxisSize: MainAxisSize.min, children: [
        TextField(controller: qty, keyboardType: TextInputType.number,
