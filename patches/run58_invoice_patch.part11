# Put backup/reset entries directly on the visible RepairsPage.
repairs_old = """      const ListTile(
        leading: Icon(Icons.fingerprint, color: gold),
        title: Text('البصمة'),
        subtitle: Text('تُطلب عند دخول المدير؛ إعادة المحاولة من شاشة القفل'),
      ),
    ],
  );
}"""

repairs_new = """      const ListTile(
        leading: Icon(Icons.fingerprint, color: gold),
        title: Text('البصمة'),
        subtitle: Text('تُطلب عند دخول المدير؛ إعادة المحاولة من شاشة القفل'),
      ),
      const Divider(),
      ListTile(
        leading: const Icon(Icons.cloud_upload, color: gold),
        title: const Text(
          'عمل نسخة احتياطية على الإيميل',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
        subtitle: const Text(
          'اضغط هنا لفتح النسخ الاحتياطي ثم اختر Gmail لإرسال النسخة إلى إيميلك',
        ),
        trailing: const Icon(Icons.chevron_left, color: gold),
        onTap: () => Navigator.push(
          context,
          MaterialPageRoute(
            builder: (_) => Scaffold(
              appBar: AppBar(title: const Text('النسخة الاحتياطية')),
              body: const AppSettings(),
            ),
          ),
        ),
      ),
      ListTile(
        leading: const Icon(Icons.restart_alt, color: Colors.redAccent, size: 30),
        title: const Text(
          'تصفير البرنامج',
          style: TextStyle(color: Colors.redAccent, fontWeight: FontWeight.bold),
        ),
        subtitle: const Text(
          'اضغط هنا لتصفير الفواتير والحركات والمخزون والأرصدة والصندوق',
        ),
        trailing: const Icon(Icons.chevron_left, color: Colors.redAccent),
        onTap: () => Navigator.push(
          context,
          MaterialPageRoute(
            builder: (_) => Scaffold(
              appBar: AppBar(title: const Text('تصفير البرنامج والنسخ الاحتياطي')),
              body: const AppSettings(),
            ),
          ),
        ),
      ),
    ],
  );
}"""

if repairs_old not in text:
    raise RuntimeError('Visible RepairsPage marker not found')
text = text.replace(repairs_old, repairs_new, 1)
p.write_text(text, encoding='utf-8')
print('visible RepairsPage backup/reset entries added')
